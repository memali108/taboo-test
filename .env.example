# Copy to .env and fill in. .env is gitignored; this file is the committed template.

# --- Required ---

# Postgres 16. Matches the Docker command in the README. No pgvector needed here.
DATABASE_URL="postgresql://postgres:tbt@localhost:5440/tabootest"

# Signs the attempt and admin cookies. 32+ random chars: openssl rand -hex 32
# Rotating this logs out admins and drops in-progress attempts.
SESSION_SECRET=""

# The single password for /admin.
ADMIN_PASSWORD=""

# --- Site ---

# Public origin, no trailing slash. Used in result links and the GHL payload.
# Baked in at BUILD time, so a change needs a redeploy (and a Railway build arg).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Integrations ---

# GoHighLevel inbound webhook; every /send submit POSTs the result here. GHL composes
# and sends the results email from the payload, so if it is unset or failing, people
# get their results page but no email. Watch the admin Health page.
# The URL saved in Admin → Settings wins; this is only the fallback.
GHL_WEBHOOK_URL=""

# --- Ops ---

# "false" skips the demo seed. Set SEED=false in production.
SEED=""

# Adds a required data-processing consent line to /send. Off by default; see SPEC §12.
# A plain runtime variable, not NEXT_PUBLIC_*, so it can be flipped without a rebuild.
REQUIRE_DATA_CONSENT=""

# Port Playwright starts next dev on. Defaults to 3100.
E2E_PORT=""
